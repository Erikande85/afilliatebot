# DAAN Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3001

# MongoDB (optional - app works without it for MVP)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/daan

# Stripe (get from https://dashboard.stripe.com)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Solana (get from https://dashboard.alchemy.com or similar)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_MAINNET_URL=https://api.mainnet-beta.solana.com
